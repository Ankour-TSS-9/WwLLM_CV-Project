# Required for AI coach, commentary, and match chat.
GROQ_API_KEY=your_groq_api_key_here
CV_PIPELINE_TIMEOUT_SECONDS=1800
# Optional speed/accuracy tradeoff; 640 is faster on CPU, but may reduce detection accuracy.
# Defaults to cv/config.py's INFERENCE_IMGSZ (currently 1280).
# CV_PIPELINE_IMGSZ=640

# Optional standalone Gemini prototype.
GEMINI_API_KEY=
# Enables on-demand voice playback in the web commentary panel and standalone TTS.
ELEVENLABS_API_KEY=
